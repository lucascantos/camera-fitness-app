{
  "$metadata": {
    "tokenSetOrder": ["primitives", "light", "dark"]
  },
  "$themes": [
    {
      "id": "fitpop-light",
      "name": "Fitpop (Light)",
      "selectedTokenSets": { "primitives": "source", "light": "enabled" }
    },
    {
      "id": "fitpop-dark",
      "name": "Fitpop (Dark)",
      "selectedTokenSets": { "primitives": "source", "dark": "enabled" }
    }
  ],

  "primitives": {
    "radius": {
      "md":   { "value": "6px",    "type": "borderRadius", "description": "rounded-md. Rare (4 uses) — small inline chips." },
      "lg":   { "value": "8px",    "type": "borderRadius", "description": "rounded-lg. Set-number tiles, small grid cells." },
      "xl":   { "value": "12px",   "type": "borderRadius", "description": "rounded-xl. Icon buttons, compact controls." },
      "2xl":  { "value": "16px",   "type": "borderRadius", "description": "rounded-2xl. THE workhorse (53 uses): cards, inset tiles, primary buttons." },
      "3xl":  { "value": "24px",   "type": "borderRadius", "description": "rounded-3xl. Major surfaces: page panels, modals, bottom sheets." },
      "full": { "value": "9999px", "type": "borderRadius", "description": "rounded-full. Pills, avatars, circular overlay buttons, progress segments." }
    },

    "font": {
      "family": {
        "sans": { "value": "Inter", "type": "fontFamilies", "description": "Falls back to system-ui. The only family in the app." }
      },
      "weight": {
        "normal":    { "value": "400", "type": "fontWeights" },
        "semibold":  { "value": "600", "type": "fontWeights" },
        "bold":      { "value": "700", "type": "fontWeights" },
        "extrabold": { "value": "800", "type": "fontWeights" },
        "black":     { "value": "900", "type": "fontWeights", "description": "Used only for the giant rest-timer numeral." }
      },
      "size": {
        "eyebrow-sm": { "value": "10px", "type": "fontSizes", "description": "Smallest label tier." },
        "eyebrow":    { "value": "11px", "type": "fontSizes", "description": "The dominant label size (27 uses)." },
        "xs":         { "value": "12px", "type": "fontSizes" },
        "sm":         { "value": "14px", "type": "fontSizes" },
        "base":       { "value": "16px", "type": "fontSizes" },
        "lg":         { "value": "18px", "type": "fontSizes" },
        "xl":         { "value": "20px", "type": "fontSizes" },
        "2xl":        { "value": "24px", "type": "fontSizes" },
        "3xl":        { "value": "30px", "type": "fontSizes" },
        "6xl":        { "value": "60px", "type": "fontSizes", "description": "Rep counter on the old desktop training panel." }
      },
      "tracking": {
        "widest": { "value": "0.1em", "type": "letterSpacing", "description": "Only ever paired with the eyebrow label." }
      }
    },

    "size": {
      "touch-min":    { "value": "44px", "type": "sizing", "description": "Minimum interactive target on mobile. Steppers and overlay buttons meet this; several desktop-era controls (40px) do not — see DESKTOP DEBT." },
      "control-sm":   { "value": "40px", "type": "sizing", "description": "Legacy desktop control size (w-10 h-10). Below the touch minimum." },
      "control-md":   { "value": "44px", "type": "sizing", "description": "Mobile stepper buttons (w-11 h-11)." }
    },

    "shadow": {
      "card": {
        "value": { "x": "0", "y": "1", "blur": "2", "spread": "0", "color": "rgba(20,20,40,0.05)" },
        "type": "boxShadow",
        "description": "The only shadow in the system. Very subtle — depth is carried by surface color, not elevation."
      }
    }
  },

  "light": {
    "color": {
      "bg":         { "value": "#F0F0F5", "type": "color", "description": "Page background." },
      "panel":      { "value": "#FFFFFF", "type": "color", "description": "Card / modal / sheet surface." },
      "panel-dark": { "value": "#EDECF2", "type": "color", "description": "Inset tile nested inside a panel." },
      "accent":     { "value": "#D8202C", "type": "color", "description": "Primary red. Active state, rep bar, destructive." },
      "accent-hov": { "value": "#B81A24", "type": "color" },
      "on-accent":  { "value": "#FFFFFF", "type": "color", "description": "Foreground on accent/good/nav fills." },
      "ink":        { "value": "#1A1330", "type": "color", "description": "Primary text." },
      "gray":       { "value": "#8A8AA0", "type": "color", "description": "Disabled / tertiary." },
      "gray-dark":  { "value": "#6C6890", "type": "color", "description": "Secondary text and all eyebrow labels." },
      "border":     { "value": "#E2E0EA", "type": "color" },
      "good":       { "value": "#3FB36B", "type": "color", "description": "Success, completed sets, increment (+) buttons." },
      "coin":       { "value": "#F2B84B", "type": "color", "description": "Currency + warning states." },
      "coin-dim":   { "value": "#A47A2A", "type": "color" },
      "nav":        { "value": "#1A1330", "type": "color", "description": "Active nav pill / primary confirm button fill." }
    }
  },

  "dark": {
    "color": {
      "bg":         { "value": "#12101B", "type": "color", "description": "Also the PWA manifest theme_color and splash background." },
      "panel":      { "value": "#1F1B2E", "type": "color" },
      "panel-dark": { "value": "#2A2540", "type": "color" },
      "accent":     { "value": "#E0323E", "type": "color", "description": "Lifted vs light theme for contrast on dark." },
      "accent-hov": { "value": "#F04C58", "type": "color" },
      "on-accent":  { "value": "#FFFFFF", "type": "color" },
      "ink":        { "value": "#F2F0F8", "type": "color" },
      "gray":       { "value": "#7C7894", "type": "color" },
      "gray-dark":  { "value": "#A7A2C4", "type": "color", "description": "Note: LIGHTER than `gray` in dark theme — the name is inherited from the light palette and is misleading. See DESKTOP DEBT." },
      "border":     { "value": "#332E47", "type": "color" },
      "good":       { "value": "#4CCB7C", "type": "color" },
      "coin":       { "value": "#F2B84B", "type": "color" },
      "coin-dim":   { "value": "#F0C666", "type": "color" },
      "nav":        { "value": "#433D6E", "type": "color" }
    }
  }
}
